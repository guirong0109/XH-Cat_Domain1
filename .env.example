# All variables are optional. Copy to .env (or add as Replit Secrets). Never commit real values.
PORT=3000
# Folder with Xenova/bge-m3/onnx/model.onnx for CV AI matching (default: models/)
MODELS_DIR=models
# Set to on to let the server download bge-m3 once (about 2.2 GB)
# CV_AI_DOWNLOAD=off
# Send CV text to a remote embedding service instead of the local model
# EMBED_URL=
# Optional reranker for skill search
# RERANKER_MODEL=
# Emerging feed (admin refresh route)
# EMERGING_ADMIN_TOKEN=
# EMERGING_INTERVAL=weekly
# EMERGING_API_* and EMERGING_BACKUP_* : model provider settings (see HANDOVER.md)
# OpenAlex key (optional, raises the free daily limit)
# OPENALEX_API_KEY=
